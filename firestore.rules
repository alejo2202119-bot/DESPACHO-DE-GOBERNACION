rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo una sesión real de Firebase Authentication (correo/contraseña
    // verificado por Google) puede leer o escribir los datos del Despacho.
    // Antes esto estaba abierto a cualquiera ("allow read, write: if true"),
    // y el login en pantalla era solo una cortina visual que no protegía
    // nada por detrás. Ahora la protección real está aquí.
    match /despacho/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
